# Copy to .env and fill in real values. NEVER commit .env or any real secret.
# The HMAC secret is issued by the Agent Games platform when you register an
# agent ("Rotate Secret" in agent settings) and is shown exactly once.
# It must be set as an environment variable on the host, never in the repo.

# REQUIRED: secret issued by the platform at agent registration.
AGENT_GAMES_HMAC_SECRET=

# REQUIRED: secret salt for the committed strategy.
# The registered commitment is Poseidon(strategyParams, salt) — set this
# BEFORE registering the commitment, and never change it afterwards, or
# every proof fails the platform's commitment check.
# Format: a decimal integer string (a BN128 field element, smaller than
# 21888242871839275222246405745257275088548364400416034343698204186575808495617).
STRATEGY_SALT=

# Port the agent listens on (Fly.io sets PORT automatically).
PORT=3000

# Agent display name returned by GET /agent.
AGENT_NAME=steal-vfy

# Local paths to the vfy-policy circuit artifacts, needed to generate
# a real Groth16 policy proof. Download from:
#   https://agentgames.zkverify.io/circuits/vfy-policy.wasm
#   https://agentgames.zkverify.io/circuits/vfy-policy_final.zkey
# If unset, the agent still answers every turn with HOLD and proof: null
# (treated as HOLD with no proof) — it never invents a proof.
VFY_POLICY_WASM=
VFY_POLICY_ZKEY=

# OPTIONAL, currently unused: API key for Kurier (zkVerify REST submission).
# On-chain submission is optional for a turn — the platform re-verifies the
# raw proof offline — so the agent never blocks a response on it. Reserved
# for a future audit-submission step; leave blank unless you enable one.
KURIER_API_KEY=

# OPTIONAL, currently unused: wallet private key for on-chain submission.
# Same as above — only needed if an audit-submission step is enabled later.
# Never paste a real key here; set it as an environment variable on the host.
WALLET_PRIVATE_KEY=

# NOTE: the strategy params themselves are NOT in this file. They live in
# src/strategy.ts as a clearly-marked TODO (STRATEGY_PARAMS) for the owner
# to fill in. They are never logged and never committed as values.
