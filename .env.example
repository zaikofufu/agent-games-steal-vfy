# Copy to .env and fill in real values. NEVER commit .env or any real secret.
# The HMAC secret is issued by the Agent Games platform when you register an
# agent ("Rotate Secret" in agent settings) and is shown exactly once.
# It must be set as an environment variable on the host, never in the repo.

# 32-byte random secret issued by the platform at agent registration.
AGENT_SECRET=<redacted>

# Port the agent listens on (Fly.io sets PORT automatically).
PORT=3000

# Agent display name returned by GET /agent.
AGENT_NAME=steal-vfy

# Optional: local paths to the vfy-policy circuit artifacts, needed to generate
# a real Groth16 policy proof. Download from:
#   https://agentgames.zkverify.io/circuits/vfy-policy.wasm
#   https://agentgames.zkverify.io/circuits/vfy-policy_final.zkey
# If unset, the agent still answers every turn with HOLD and proof: null
# (treated as HOLD with no proof) — it never invents a proof.
VFY_POLICY_WASM=
VFY_POLICY_ZKEY=

# Optional: override the committed strategy salt (a decimal field element).
# Default is derived deterministically from the strategy id (see
# src/strategy.ts). Only change this BEFORE registering the commitment:
# the registered commitment is Poseidon(strategyParams, salt), so changing
# the salt after registration invalidates every proof.
STRATEGY_SALT=
